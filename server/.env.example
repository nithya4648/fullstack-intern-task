PORT=5000
JWT_SECRET=change_this_to_a_long_random_string

# Frontend origin URL for CORS (comma-separated if multiple origins)
CLIENT_URL=http://localhost:5173

# MongoDB connection string (e.g. MongoDB Atlas or local MongoDB instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/saas_db?retryWrites=true&w=majority
